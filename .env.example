# Copy this file to .env for local `netlify dev`, and set the same
# variables in Netlify's dashboard (Site settings -> Environment
# variables) for production. Never commit the real .env file.

# Server-side only -- used by netlify/functions/reason.mjs
GEMINI_API_KEY=your-gemini-api-key-here

# Client-side (safe to expose -- this is the publishable/anon key,
# not a secret; RLS is what actually protects the data).
# These values point at the real "job-discovery-engine" Supabase
# project created for this app.
VITE_SUPABASE_URL=https://tmwkthuvagfoeidthdwz.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_6juu2aD1dLlf7pWddu3Spg_A8jiK4aH

# Server-side ONLY, used by netlify/functions/discover-brightermonday.mjs.
# This is the service_role SECRET key (Supabase dashboard -> Project
# Settings -> API -> service_role), NOT the anon key above. It bypasses
# RLS entirely, which is deliberate -- the scraper is a trusted backend
# process, not a user request -- but that also means it must never be
# exposed client-side or committed anywhere. Get it fresh from the
# dashboard; it is never printed or stored by anything in this repo.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-here
